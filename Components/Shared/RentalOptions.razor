@inject RentalState RentalState
@implements IDisposable

<section class="rental-options" aria-label="Kiralama tarihleri ve ek hizmetler">
    <div class="rental-date-grid">
        <label class="form-field"><span>TESLİM ALMA TARİHİ</span><input type="date" min="@Today" @bind="PickupDate" @bind:after="OnSelectionChanged" /></label>
        <label class="form-field"><span>İADE TARİHİ</span><input type="date" min="@ReturnMin" @bind="ReturnDate" @bind:after="OnSelectionChanged" /></label>
    </div>
    <div class="extras-heading"><div><span class="eyebrow">İSTEĞE BAĞLI</span><h3>Yolculuğunu tamamla</h3></div><span class="extras-hint">İhtiyacına göre ekle</span></div>
    <div class="extras-list">
        @foreach (var extra in Extras)
        {
            <label class="extra-option">
                <input type="checkbox" checked="@SelectedExtraIds.Contains(extra.Id)" @onchange="e => ToggleExtra(extra.Id, e.Value is true)" />
                <span class="checkmark"></span><span class="extra-copy"><strong>@extra.Name</strong><small>@extra.Description</small></span><span class="extra-price">@extra.DailyPrice ₺ <small>/ gün</small></span>
            </label>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public DateTime PickupDate { get; set; }
    [Parameter] public EventCallback<DateTime> PickupDateChanged { get; set; }
    [Parameter, EditorRequired] public DateTime ReturnDate { get; set; }
    [Parameter] public EventCallback<DateTime> ReturnDateChanged { get; set; }
    [Parameter, EditorRequired] public HashSet<string> SelectedExtraIds { get; set; } = [];
    [Parameter] public EventCallback<HashSet<string>> SelectedExtraIdsChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static string Today => DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string ReturnMin => (PickupDate.Date >= DateTime.Today ? PickupDate.Date : DateTime.Today).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private static readonly RentalExtra[] Extras = [
        new("insurance", "Tam kapsamlı güvence", 250, "Yolculuğun boyunca için rahat olsun"),
        new("child-seat", "Çocuk koltuğu", 75, "Küçük yolcular için güvenli konfor"),
        new("extra-driver", "Ek sürücü", 150, "Direksiyonu yol arkadaşınla paylaş")
    ];

    protected override void OnInitialized()
    {
        RentalState.SetDates(PickupDate, ReturnDate);
        RentalState.OnChange += HandleStateChanged;
    }

    private async Task OnSelectionChanged()
    {
        RentalState.SetDates(PickupDate, ReturnDate);
        await PickupDateChanged.InvokeAsync(PickupDate);
        await ReturnDateChanged.InvokeAsync(ReturnDate);
        await OnChanged.InvokeAsync();
    }

    private async Task ToggleExtra(string id, bool selected)
    {
        RentalState.ToggleExtra(id, selected);
        var next = new HashSet<string>(SelectedExtraIds);
        if (selected) next.Add(id); else next.Remove(id);
        await SelectedExtraIdsChanged.InvokeAsync(next);
        await OnChanged.InvokeAsync();
    }

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => RentalState.OnChange -= HandleStateChanged;
}
