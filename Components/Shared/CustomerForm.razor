<EditForm Model="_customer" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-summary" />
    <div class="customer-form-grid">
        <label class="form-field">
            <span class="field-label">AD SOYAD <b class="req">*</b></span>
            <InputText class="custom-input" @bind-Value="_customer.CustomerName" disabled="@IsDisabled" placeholder="Örn. Deniz Yılmaz" />
            <ValidationMessage For="() => _customer.CustomerName" />
        </label>
        <label class="form-field">
            <span class="field-label">E-POSTA ADRESİ <b class="req">*</b></span>
            <InputText class="custom-input" @bind-Value="_customer.Email" disabled="@IsDisabled" type="email" placeholder="ornek@mail.com" />
            <ValidationMessage For="() => _customer.Email" />
        </label>
        <label class="form-field">
            <span class="field-label">TELEFON NUMARASI <b class="req">*</b></span>
            <InputText class="custom-input" @bind-Value="_customer.Phone" disabled="@IsDisabled" type="tel" placeholder="05XX XXX XX XX" />
            <ValidationMessage For="() => _customer.Phone" />
        </label>
    </div>
    <div class="form-actions">
        <div class="guarantee-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#25594b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <div>
                <strong>Güvenli Rezervasyon</strong>
                <span>Ücretsiz iptal hakkı, kredi kartsız ön onay</span>
            </div>
        </div>
        <button class="button-primary submit-button" type="submit" disabled="@IsDisabled">
            Rezervasyonu Tamamla <span class="arrow-icon">→</span>
        </button>
    </div>
</EditForm>

@code {
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public EventCallback<CustomerInput> OnValidCustomerSubmit { get; set; }

    private CustomerInput _customer = new();

    private async Task SubmitAsync()
    {
        await OnValidCustomerSubmit.InvokeAsync(_customer);
    }
}
