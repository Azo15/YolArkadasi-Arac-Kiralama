@page "/cars/{Id}/rent"
@inject CarService Cars
@inject BookingState BookingState
@inject RentalState RentalState
@inject IJSRuntime JS

<PageTitle>Rezervasyon oluştur | yolarkadaşı</PageTitle>

@if (_loading)
{
    <div class="loading-state"><span class="loader"></span><p>Araç bilgileri yükleniyor...</p></div>
}
else if (_car is null)
{
    <div class="empty-state"><strong>Araç bulunamadı.</strong><a class="button-primary" href="/">Araçlara dön</a></div>
}
else
{
    <div class="rental-page">
        <a href="/" class="back-link">← Araçlara dön</a>
        <div class="rental-heading">
            <div>
                <span class="eyebrow">BİRKAÇ ADIMDA HAZIR</span>
                <h1>Yolculuğunu planla.</h1>
                <p>@_car.Brand @_car.Model için tarihleri ve sana uygun ek hizmetleri seç.</p>
            </div>
        </div>

        <!-- Kiralama Aşamaları İlerleme Çubuğu (Multi-Step Stepper) -->
        <nav class="rental-stepper" aria-label="Kiralama adımları">
            <div class="stepper-item step-completed">
                <div class="step-circle">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div class="step-text">
                    <span class="step-number">ADIM 1</span>
                    <strong class="step-label">Araç Seçimi</strong>
                    <small class="step-sub">@_car.Brand @_car.Model</small>
                </div>
            </div>

            <div class="stepper-line @(_success ? "line-completed" : "line-active")" aria-hidden="true"></div>

            <div class="stepper-item @(_success ? "step-completed" : "step-active")">
                <div class="step-circle">
                    @if (_success)
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                    }
                    else
                    {
                        <span>2</span>
                    }
                </div>
                <div class="step-text">
                    <span class="step-number">ADIM 2</span>
                    <strong class="step-label">Tarih & Hizmet</strong>
                    <small class="step-sub">@(_success ? "Tamamlandı" : "Seçim yapılıyor")</small>
                </div>
            </div>

            <div class="stepper-line @(_success ? "line-completed" : "")" aria-hidden="true"></div>

            <div class="stepper-item @(_success ? "step-completed step-highlight" : "step-pending")">
                <div class="step-circle">
                    @if (_success)
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                    }
                    else
                    {
                        <span>3</span>
                    }
                </div>
                <div class="step-text">
                    <span class="step-number">ADIM 3</span>
                    <strong class="step-label">Onay & Kod</strong>
                    <small class="step-sub">@(_success ? _bookingCode : "Son adım")</small>
                </div>
            </div>
        </nav>

        <!-- Üst Belirgin Bildirim Alanı (Sayfa Başı) -->
        <div id="booking-alert-top">
            @if (!_car.IsAvailable)
            {
                <div class="alert-box alert-unavailable">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    <span>Bu araç şu anda kiralanabilir durumda değil. Başka bir araç seçebilirsin.</span>
                </div>
            }
            @if (_showConflictAlert && _hasDateConflict)
            {
                <div class="alert-box alert-conflict conflict-alert" role="alert">
                    <div class="alert-conflict-icon">!</div>
                    <div class="alert-conflict-text">
                        <strong>Rezervasyon Adımı Tamamlanamadı: Tarih Çakışması</strong>
                        <p>
                            <b>@_car.Brand @_car.Model</b> aracı, seçtiğiniz <b>@_pickupDate.ToString("dd MMMM yyyy", TrCulture) – @_returnDate.ToString("dd MMMM yyyy", TrCulture)</b> tarihlerinde zaten doludur.
                            Lütfen teslim alma veya iade tarihlerini güncelleyerek adımları tekrar deneyin.
                        </p>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                @if (_success)
                {
                    <div class="alert-box alert-success-prominent" role="alert">
                        <div class="success-icon-bubble">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        <div class="success-message-text">
                            <strong>Rezervasyonunuz Başarıyla Oluşturuldu!</strong>
                            <p>Aracınız adınıza ayrıldı. Rezervasyon kodunuz: <span class="badge-booking-code">@_bookingCode</span></p>
                        </div>
                        <a href="/my-bookings" class="btn-alert-bookings">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="m9 14 2 2 4-4"/></svg>
                            <span>Rezervasyonlarıma Git</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="alert-box alert-error-prominent" role="alert">
                        <div class="error-icon-bubble">!</div>
                        <span>@_message</span>
                    </div>
                }
            }
        </div>

        <div class="rental-layout">
            <div class="rental-main-column">
                <section class="selected-car-panel">
                    <img src="@_car.ImageUrl" alt="@_car.Brand @_car.Model" />
                    <div class="selected-car-info">
                        <span class="category-pill-inline">@_car.Category</span>
                        <h2>@_car.Brand @_car.Model</h2>
                        <p>@_car.Seats kişi · @_car.Transmission · @_car.FuelType</p>
                        <strong>@_car.DailyPrice.ToString("N0") ₺ <small>/ gün</small></strong>
                    </div>
                    <span class="selected-check">✓</span>
                </section>

                <RentalOptions @bind-PickupDate="_pickupDate" @bind-ReturnDate="_returnDate" @bind-SelectedExtraIds="_selectedExtraIds" OnChanged="OnSelectionChanged" />

                <!-- Müşteri İletişim Formu & Alt Tebrik Kartı -->
                <section class="customer-panel">
                    <div class="extras-heading">
                        <div>
                            <span class="eyebrow">SON ADIM</span>
                            <h3>İletişim bilgilerin</h3>
                        </div>
                        <span class="extras-hint">* Zorunlu alanlar</span>
                    </div>

                    @if (_hasDateConflict)
                    {
                        <div class="customer-step-conflict-card" role="alert">
                            <div class="step-conflict-badge">!</div>
                            <div class="step-conflict-details">
                                <h4>Adım Tamamlanamıyor: Araç Seçilen Tarihlerde Dolu</h4>
                                <p>
                                    <b>@_car.Brand @_car.Model</b> aracı, seçtiğiniz 
                                    <b>@_pickupDate.ToString("dd MMMM yyyy", TrCulture) – @_returnDate.ToString("dd MMMM yyyy", TrCulture)</b> 
                                    tarihleri arasında başka bir rezervasyonla kiralanmıştır. Bu sebeple sonraki adıma geçilemiyor ve rezervasyon onaylanamıyor.
                                </p>

                                <!-- MÜŞTERİ KAÇMASIN DİYE: EN YAKIN MÜSAİT TARİH ÖNERİLERİ -->
                                <div class="suggested-dates-container">
                                    <div class="suggested-dates-header">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        <span><b>@_car.Brand @_car.Model</b> İçin En Erken Müsait Tarihler (Tek Tıkla Uygula):</span>
                                    </div>
                                    <div class="suggested-chips-list">
                                        @foreach (var suggestion in GetAvailableDateSuggestions())
                                        {
                                            <button type="button" class="btn-suggested-date" @onclick="() => ApplySuggestedDates(suggestion.Pickup, suggestion.Return)" title="Bu tarihleri seç ve rezervasyona devam et">
                                                <div class="date-chip-info">
                                                    <strong class="date-chip-range">@suggestion.Pickup.ToString("dd MMM", TrCulture) – @suggestion.Return.ToString("dd MMM yyyy", TrCulture)</strong>
                                                    <span class="date-chip-badge">@suggestion.Days Gün Müsait</span>
                                                </div>
                                                <span class="date-chip-action">Tarihi Seç ✓</span>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="step-conflict-solution">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                    <span>Tarih aramakla uğraşmayın: Yukarıdaki müsait tarih seçeneklerinden birine tıklayarak anında kiralama formunu doldurabilirsiniz.</span>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_success && !string.IsNullOrWhiteSpace(_bookingCode))
                    {
                        <div class="in-place-success-card" role="alert">
                            <div class="success-glow-icon">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                            </div>
                            <h4>Rezervasyonun Başarıyla Alındı!</h4>
                            <p>Tebrikler! @_car.Brand @_car.Model için rezervasyon kaydın tamamlandı.</p>
                            <div class="in-place-code-box">
                                <span class="label">REZERVASYON KODUN:</span>
                                <strong class="code">@_bookingCode</strong>
                            </div>
                            <div class="in-place-actions">
                                <a href="/my-bookings" class="btn-in-place-primary">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="m9 14 2 2 4-4"/></svg>
                                    <span>Rezervasyonlarıma Git</span>
                                </a>
                                <a href="/cars" class="btn-in-place-secondary">Yeni Araç Kirala</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <CustomerForm IsDisabled="@(!_car.IsAvailable || _hasDateConflict || !HasValidDates)" HasConflict="@_hasDateConflict" OnValidCustomerSubmit="CreateBookingAsync" />
                    }
                </section>
            </div>
            <RentalSummary Car="_car" PickupDate="_pickupDate" ReturnDate="_returnDate" SelectedExtraIds="_selectedExtraIds" />
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private Car? _car;
    private bool _loading = true;
    private DateTime _pickupDate = DateTime.Today.AddDays(1);
    private DateTime _returnDate = DateTime.Today.AddDays(2);
    private HashSet<string> _selectedExtraIds = [];
    private string? _message;
    private string? _bookingCode;
    private bool _success;
    private bool _hasDateConflict;
    private bool _showConflictAlert;
    private string? _initializedCarId;
    private bool HasValidDates => _pickupDate.Date >= DateTime.Today && _returnDate.Date > _pickupDate.Date;

    protected override async Task OnParametersSetAsync()
    {
        if (_initializedCarId == Id) return;
        _initializedCarId = Id;
        _loading = true;

        try { _car = (await Cars.GetCarsAsync()).FirstOrDefault(car => car.Id == Id); }
        finally { _loading = false; }

        await BookingState.EnsureLoadedAsync();

        _pickupDate = DateTime.Today.AddDays(1);
        _returnDate = _pickupDate.AddDays(1);
        _selectedExtraIds = [];

        // Start with the first available one-day range so a new booking does not open on a conflict.
        for (var daysAhead = 0; _car is not null && daysAhead < 365 && BookingState.HasConflict(_car.Id, _pickupDate, _returnDate); daysAhead++)
        {
            _pickupDate = _pickupDate.AddDays(1);
            _returnDate = _returnDate.AddDays(1);
        }

        RentalState.StartNewRental(Id, _pickupDate, _returnDate);
        _message = null;
        _bookingCode = null;
        _success = false;
        RefreshDateConflict();
    }

    private void OnSelectionChanged()
    {
        _message = null;
        _bookingCode = null;
        _showConflictAlert = false;
        RefreshDateConflict();
    }

    private void RefreshDateConflict()
    {
        _hasDateConflict = _car is not null && HasValidDates && BookingState.HasConflict(_car.Id, _pickupDate, _returnDate);
    }

    private static readonly CultureInfo TrCulture = new("tr-TR");

    private record DateSuggestion(DateTime Pickup, DateTime Return, int Days);

    private List<DateSuggestion> GetAvailableDateSuggestions()
    {
        if (_car is null) return [];
        var suggestions = new List<DateSuggestion>();
        var duration = Math.Max(1, (_returnDate.Date - _pickupDate.Date).Days);

        var cursor = DateTime.Today.AddDays(1);
        if (_returnDate.Date > cursor) cursor = _returnDate.Date;

        for (var offset = 0; offset < 90 && suggestions.Count < 3; offset++)
        {
            var candidatePickup = cursor.AddDays(offset);
            var candidateReturn = candidatePickup.AddDays(duration);
            if (!BookingState.HasConflict(_car.Id, candidatePickup, candidateReturn))
            {
                suggestions.Add(new DateSuggestion(candidatePickup, candidateReturn, duration));
                offset += duration;
            }
        }

        if (suggestions.Count < 2)
        {
            var fallbackCursor = DateTime.Today.AddDays(1);
            for (var d = 0; d < 30 && suggestions.Count < 3; d++)
            {
                var p = fallbackCursor.AddDays(d);
                var r = p.AddDays(duration);
                if (!BookingState.HasConflict(_car.Id, p, r) && !suggestions.Any(s => s.Pickup == p))
                {
                    suggestions.Add(new DateSuggestion(p, r, duration));
                    d += duration;
                }
            }
        }

        return suggestions.OrderBy(s => s.Pickup).Take(3).ToList();
    }

    private void ApplySuggestedDates(DateTime pickup, DateTime dropoff)
    {
        _pickupDate = pickup;
        _returnDate = dropoff;
        RentalState.SetDates(pickup, dropoff);
        OnSelectionChanged();
    }

    private async Task CreateBookingAsync(CustomerInput customer)
    {
        if (_car is null || !_car.IsAvailable) return;
        RefreshDateConflict();
        if (_hasDateConflict)
        {
            _showConflictAlert = true;
            _message = $"{_car.Brand} {_car.Model} seçtiğiniz {_pickupDate:dd MMMM yyyy} – {_returnDate:dd MMMM yyyy} tarihlerinde başka bir rezervasyona sahiptir. Lütfen tarihleri değiştirin.";
            _success = false;
            await ScrollToTopAsync();
            return;
        }

        if (_pickupDate.Date < DateTime.Today || _returnDate.Date <= _pickupDate.Date)
        {
            _message = "Teslim alma tarihi bugün veya sonrası, iade tarihi teslim alma tarihinden sonra olmalıdır.";
            _success = false;
            await ScrollToTopAsync();
            return;
        }

        await BookingState.EnsureLoadedAsync();
        if (BookingState.HasConflict(_car.Id, _pickupDate, _returnDate))
        {
            _message = "Bu araç seçtiğin tarihlerde başka bir rezervasyona sahip. Lütfen farklı tarih seç.";
            _success = false;
            _hasDateConflict = true;
            await ScrollToTopAsync();
            return;
        }

        var days = (_returnDate.Date - _pickupDate.Date).Days;
        var extras = new Dictionary<string, decimal> { ["insurance"] = 250, ["child-seat"] = 75, ["extra-driver"] = 150 };
        var total = days * (_car.DailyPrice + _selectedExtraIds.Where(extras.ContainsKey).Sum(id => extras[id]));
        var booking = new CarBooking
        {
            Id = $"CAR-{DateTime.Today:yyyy}-{Random.Shared.Next(100, 1000)}",
            CarId = _car.Id,
            CustomerName = customer.CustomerName.Trim(),
            Email = customer.Email.Trim(),
            Phone = customer.Phone.Trim(),
            PickupDate = _pickupDate.Date,
            ReturnDate = _returnDate.Date,
            ExtraIds = _selectedExtraIds.ToList(),
            TotalAmount = total
        };
        try
        {
            await BookingState.AddAsync(booking);
            _success = true;
            _bookingCode = booking.Id;
            _message = $"Rezervasyonun oluşturuldu. Kodun: {booking.Id}";
            await ScrollToTopAsync();
            await TriggerConfettiAsync();
        }
        catch (InvalidOperationException ex)
        {
            _success = false;
            _message = ex.Message;
            await ScrollToTopAsync();
        }
    }

    private async Task TriggerConfettiAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("launchCelebrationConfetti");
        }
        catch
        {
            // Ignore if JS execution fails or is prerendering
        }
    }

    private async Task ScrollToTopAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollToTop");
        }
        catch
        {
            // Ignore if JS execution fails or is prerendering
        }
    }
}
