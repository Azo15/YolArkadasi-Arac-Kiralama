@page "/"
@page "/cars"
@inject CarService Cars
@implements IDisposable

<PageTitle>Araç Kirala | yolarkadaşı</PageTitle>

<!-- 1. EN ÜSTTE: GELİŞMİŞ ARAÇ VİTRİN SLİDER'I (SLAYDBAR) -->
@if (!_loading && _error is null && CurrentFeaturedCar is not null)
{
    <section class="top-showcase-slider" aria-label="Öne çıkan araç filosu">
        <div class="showcase-slider-card">
            <div class="showcase-grid">
                <!-- Sol Panel: Araç Detayı & Aksiyon -->
                <div class="showcase-info">
                    <div class="showcase-eyebrow">
                        <span class="live-pulse"></span>
                        <span class="eyebrow-text">GÜNCEL FİLO VİTRİNİ</span>
                        <span class="category-pill">@CurrentFeaturedCar.Category</span>
                    </div>

                    <div class="showcase-title-area">
                        <h2>@CurrentFeaturedCar.Brand <span>@CurrentFeaturedCar.Model</span></h2>
                        <div class="showcase-specs-row">
                            <span class="spec-chip">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                                @CurrentFeaturedCar.Transmission
                            </span>
                            <span class="spec-chip">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 2v20"/><path d="M7 2v20"/><path d="M11 2v20"/><path d="M15 2v20"/><path d="M19 2v20"/></svg>
                                @CurrentFeaturedCar.FuelType
                            </span>
                            <span class="spec-chip">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                @CurrentFeaturedCar.Seats Kişilik
                            </span>
                        </div>
                    </div>

                    <div class="showcase-cta-row">
                        <div class="showcase-price-box">
                            <span class="price-prefix">GÜNLÜK KİRALAMA</span>
                            <div class="price-amount"><strong>@CurrentFeaturedCar.DailyPrice.ToString("N0") ₺</strong> <small>/ gün</small></div>
                        </div>
                        <a href="cars/@CurrentFeaturedCar.Id/rent" class="showcase-rent-cta">
                            <span>Bu Aracı Kirala</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
                        </a>
                    </div>

                    <!-- Gelişmiş Slaydbar / Sekmeli Araç Değiştirici -->
                    <div class="showcase-slaydbar-strip">
                        <button type="button" class="slaydbar-btn prev" aria-label="Önceki araç" @onclick="PrevFeaturedSlide">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <div class="slaydbar-tabs">
                            @for (int i = 0; i < _showcaseCars.Count; i++)
                            {
                                var idx = i;
                                var car = _showcaseCars[idx];
                                var isSel = (idx == _activeShowcase);
                                <button type="button" 
                                        class="slaydbar-tab @(isSel ? "active" : "")" 
                                        @onclick="() => SelectFeaturedSlide(idx)">
                                    <span class="tab-index">0@(idx + 1)</span>
                                    <span class="tab-car-title">@car.Brand @car.Model</span>
                                </button>
                            }
                        </div>
                        <button type="button" class="slaydbar-btn next" aria-label="Sonraki araç" @onclick="NextFeaturedSlide">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>
                </div>

                <!-- Sağ Panel: Büyük Sinematik Araç Görseli -->
                <div class="showcase-image-panel" @key="CurrentFeaturedCar.Id">
                    <div class="car-img-wrapper">
                        <img src="@CurrentFeaturedCar.ImageUrl" alt="@CurrentFeaturedCar.Brand @CurrentFeaturedCar.Model" class="showcase-photo" />
                        <div class="car-img-glow"></div>
                        <div class="car-floating-tag">
                            <span>YOL ARKADAŞIN HAZIR</span>
                            <strong>@CurrentFeaturedCar.Brand @CurrentFeaturedCar.Model</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- 2. HEMEN ALTINDA: AYNI BOYUTTA TAM EKRANA SIĞAN KARTLAR GRİDİ -->
<section class="screen-cards-grid" aria-label="Hızlı işlemler ve özellikler">
    <!-- Üst İkili Sıra -->
    <div class="cards-duo-row">
        <!-- Kart 1: Ana Tanıtım & Hızlı Butonlar -->
        <div class="screen-card hero-action-card">
            <div class="card-eyebrows">
                <span class="badge-pill-dark">GÜNCEL FİLO 2026</span>
                <span class="badge-pill-light">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    Güvenli Rezervasyon
                </span>
            </div>
            <h3>Hayalindeki yolculuk burada <span>başlıyor.</span></h3>
            <p>
                İster şehir içi ekonomik bir sürüş, ister geniş aile yolculuğu veya prestijli bir lüks sedan. 
                İhtiyacına uygun aracı seç, şeffaf fiyatlarla dakikalar içinde rezervasyonunu tamamla.
            </p>
            <div class="action-buttons-flex">
                <a href="/cars#fleet" class="btn-card-primary">
                    <span>Araçları İncele</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
                </a>
                <a href="/my-bookings" class="btn-card-secondary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="m9 14 2 2 4-4"/></svg>
                    <span>Rezervasyonlarım</span>
                </a>
                <a href="tel:08503400024" class="btn-card-outline">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <span>7/24 Destek</span>
                </a>
            </div>
        </div>

        <!-- Kart 2: 3 Adımda Kolay Kiralama -->
        <div class="screen-card steps-process-card">
            <div class="process-header">
                <span class="badge-pill-process">NASIL ÇALIŞIR?</span>
                <h4>3 Kolay Adımda Yola Çık</h4>
            </div>
            <div class="process-steps-list">
                <div class="process-step-row">
                    <div class="step-num-badge">01</div>
                    <div class="step-desc">
                        <strong>Aracını Belirle</strong>
                        <p>Kategori, yakıt ve bütçene göre en uygun aracı filtrele.</p>
                    </div>
                </div>
                <div class="process-step-row">
                    <div class="step-num-badge">02</div>
                    <div class="step-desc">
                        <strong>Tarihleri Seç</strong>
                        <p>Teslim ve iade tarihlerini belirle, ek hizmetlerini ekle.</p>
                    </div>
                </div>
                <div class="process-step-row">
                    <div class="step-num-badge">03</div>
                    <div class="step-desc">
                        <strong>Rezervasyonunu Tamamla</strong>
                        <p>Benzersiz CAR kodunla aracını hemen teslim al.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alt Dörtlü Sıra: Tam Ekrana Sığan 4'lü Güvence Kartları -->
    <div class="cards-quartet-row">
        <div class="screen-card trust-item-card">
            <div class="trust-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div class="trust-content">
                <strong>3 Dakikada Onay</strong>
                <p>Kredi kartsız hızlı ön kayıt</p>
            </div>
        </div>
        <div class="screen-card trust-item-card">
            <div class="trust-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
            </div>
            <div class="trust-content">
                <strong>Ücretsiz İptal</strong>
                <p>Kesintisiz iptal ve iade hakkı</p>
            </div>
        </div>
        <div class="screen-card trust-item-card">
            <div class="trust-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 10.8 2 11 2 11.3V16c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
            </div>
            <div class="trust-content">
                <strong>12 Model Araç</strong>
                <p>4 farklı kategoride güncel filo</p>
            </div>
        </div>
        <div class="screen-card trust-item-card">
            <div class="trust-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div class="trust-content">
                <strong>Tam Kasko</strong>
                <p>Muafiyetsiz güvenli sürüş paketi</p>
            </div>
        </div>
    </div>
</section>

<!-- 3. FİLO KATALOĞU -->
<div id="fleet">
    @if (_loading)
    {
        <div class="loading-state">
            <span class="loader"></span>
            <p>Araç filosu yükleniyor...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="empty-state">
            <strong>Araç listesi şu an yüklenemedi.</strong>
            <p>@_error</p>
        </div>
    }
    else
    {
        <CarList Cars="_cars" />
    }
</div>

@code {
    private List<Car> _cars = [];
    private bool _loading = true;
    private string? _error;
    private int _activeShowcase;
    private System.Threading.Timer? _sliderTimer;

    private List<Car> _showcaseCars
    {
        get
        {
            if (_cars.Count == 0) return [];
            var curated = _cars.Where(c => c.Id is "C008" or "C007" or "C011" or "C006" or "C001")
                               .OrderByDescending(c => c.DailyPrice)
                               .ToList();
            return curated.Count > 0 ? curated : _cars.Take(5).ToList();
        }
    }

    private Car? CurrentFeaturedCar => _showcaseCars.Count == 0 ? null : _showcaseCars[_activeShowcase % _showcaseCars.Count];

    private void PrevFeaturedSlide()
    {
        if (_showcaseCars.Count > 0)
        {
            _activeShowcase = (_activeShowcase - 1 + _showcaseCars.Count) % _showcaseCars.Count;
            RestartSliderTimer();
        }
    }

    private void NextFeaturedSlide()
    {
        if (_showcaseCars.Count > 0)
        {
            _activeShowcase = (_activeShowcase + 1) % _showcaseCars.Count;
        }
    }

    private void SelectFeaturedSlide(int index)
    {
        if (_showcaseCars.Count > 0 && index >= 0 && index < _showcaseCars.Count)
        {
            _activeShowcase = index;
            RestartSliderTimer();
        }
    }

    private void RestartSliderTimer()
    {
        _sliderTimer?.Change(TimeSpan.FromSeconds(6), TimeSpan.FromSeconds(5));
    }

    private void StartSliderTimer()
    {
        _sliderTimer?.Dispose();
        _sliderTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() =>
            {
                NextFeaturedSlide();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnInitializedAsync()
    {
        try 
        { 
            _cars = (await Cars.GetCarsAsync()).ToList(); 
            StartSliderTimer();
        }
        catch (Exception ex) 
        { 
            _error = ex.Message; 
        }
        finally 
        { 
            _loading = false; 
        }
    }

    public void Dispose()
    {
        _sliderTimer?.Dispose();
    }
}
