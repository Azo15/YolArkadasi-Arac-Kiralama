@page "/"
@page "/cars"
@inject CarService Cars

<PageTitle>Araç Kirala | yolarkadaşı</PageTitle>

<section class="hero-banner">
    <div class="hero-content">
        <div class="hero-eyebrow-row">
            <span class="eyebrow-badge">GÜNCEL FİLO 2026</span>
            <span class="trust-badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Güvenli Rezervasyon
            </span>
        </div>
        <h1>Hayalindeki yolculuk burada <span>başlıyor.</span></h1>
        <p class="hero-description">
            İster şehir içi ekonomik bir sürüş, ister geniş aile yolculuğu veya prestijli bir lüks sedan. 
            İhtiyacına uygun aracı seç, şeffaf fiyatlarla dakikalar içinde rezervasyonunu tamamla.
        </p>

        <!-- Hızlı Aksiyon Butonları -->
        <div class="hero-action-buttons">
            <a href="/cars#fleet" class="hero-btn-primary">
                <span>Araçları İncele</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
            </a>
            <a href="/my-bookings" class="hero-btn-secondary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="m9 14 2 2 4-4"/></svg>
                <span>Rezervasyonlarım</span>
            </a>
            <a href="tel:08503400024" class="hero-btn-outline">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span>7/24 Destek</span>
            </a>
        </div>

        <!-- Avantaj Rozetleri -->
        <div class="hero-stats-row">
            <div class="stat-pill">
                <svg class="stat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                <div>
                    <strong>3 Dakikada Onay</strong>
                    <small>Kredi kartsız ön kayıt</small>
                </div>
            </div>
            <div class="stat-pill">
                <svg class="stat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
                <div>
                    <strong>Ücretsiz İptal</strong>
                    <small>Kesintisiz iptal hakkı</small>
                </div>
            </div>
            <div class="stat-pill">
                <svg class="stat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 10.8 2 11 2 11.3V16c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
                <div>
                    <strong>12 Model Araç</strong>
                    <small>4 farklı araç kategorisi</small>
                </div>
            </div>
            <div class="stat-pill">
                <svg class="stat-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <div>
                    <strong>Tam Kasko</strong>
                    <small>Güvenli sürüş paketi</small>
                </div>
            </div>
        </div>
    </div>
</section>

@if (!_loading && _error is null && _showcaseCars.Count > 0)
{
<section class="hero-car-showcase" aria-label="Araçlarımızdan seçmeler">
    <div class="showcase-copy">
        <span class="showcase-kicker"><i></i> YOLA ÇIKMAYA HAZIR</span>
        <h2>Her yolculuğa<br /><span>bir yol arkadaşı.</span></h2>
        <p>Şehirden sahil yoluna, sana uygun aracı keşfet.</p>
        <div class="showcase-controls">
            <button type="button" class="showcase-arrow" aria-label="Önceki araç" @onclick="PreviousShowcase">←</button>
        <span class="showcase-count">@((_activeShowcase + 1).ToString("00")) <i>/</i> @_showcaseCars.Count.ToString("00")</span>
            <button type="button" class="showcase-arrow" aria-label="Sonraki araç" @onclick="NextShowcase">→</button>
        </div>
    </div>
    <div class="showcase-stage" aria-live="polite">
        <div class="showcase-orbit orbit-one"></div>
        <div class="showcase-orbit orbit-two"></div>
        <span class="showcase-glow"></span>
        @for (var offset = -1; offset <= 1; offset++)
        {
            var index = (_activeShowcase + offset + _showcaseCars.Count) % _showcaseCars.Count;
            var car = _showcaseCars[index];
            <button @key="car.Id" type="button" class="showcase-car @(offset == 0 ? "is-active" : offset < 0 ? "is-previous" : "is-next")" @onclick="() => SelectShowcase(index)" aria-label="@($"{car.Brand} {car.Model} aracını göster")">
                <img src="@car.ImageUrl" alt="" />
                @if (offset == 0)
                {
                    <span class="showcase-car-label"><b>@car.Brand @car.Model</b><small>@car.Category <i>·</i> @car.DailyPrice.ToString("N0") ₺ / gün</small></span>
                }
            </button>
        }
        <div class="showcase-glass-note"><span>✦</span> 12 özenle seçilmiş model</div>
    </div>
</section>
}

<!-- 3 Adımda Nasıl Çalışır Şeridi -->
<section class="how-it-works-strip">
    <div class="step-card">
        <span class="step-num">01</span>
        <div>
            <strong>1. Aracını Belirle</strong>
            <p>Kategori, yakıt ve bütçene göre en uygun aracı filtrele.</p>
        </div>
    </div>
    <div class="step-card">
        <span class="step-num">02</span>
        <div>
            <strong>2. Tarihleri Seç</strong>
            <p>Teslim ve iade tarihlerini belirle, ek hizmetlerini ekle.</p>
        </div>
    </div>
    <div class="step-card">
        <span class="step-num">03</span>
        <div>
            <strong>3. Rezervasyonunu Tamamla</strong>
            <p>Benzersiz CAR kodunla aracını hemen teslim al.</p>
        </div>
    </div>
</section>

<div id="fleet">
    @if (_loading)
    {
        <div class="loading-state">
            <span class="loader"></span>
            <p>Araç filosu yükleniyor...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="empty-state">
            <strong>Araç listesi şu an yüklenemedi.</strong>
            <p>@_error</p>
        </div>
    }
    else
    {
        <CarList Cars="_cars" />
    }
</div>

@code {
    private List<Car> _cars = [];
    private bool _loading = true;
    private string? _error;
    private int _activeShowcase;
    private List<Car> _showcaseCars => _cars.Take(5).ToList();

    private void PreviousShowcase() { if (_showcaseCars.Count > 0) _activeShowcase = (_activeShowcase - 1 + _showcaseCars.Count) % _showcaseCars.Count; }
    private void NextShowcase() { if (_showcaseCars.Count > 0) _activeShowcase = (_activeShowcase + 1) % _showcaseCars.Count; }
    private void SelectShowcase(int index) { if (_showcaseCars.Count > 0) _activeShowcase = index; }

    protected override async Task OnInitializedAsync()
    {
        try 
        { 
            _cars = (await Cars.GetCarsAsync()).ToList(); 
        }
        catch (Exception ex) 
        { 
            _error = ex.Message; 
        }
        finally 
        { 
            _loading = false; 
        }
    }
}
