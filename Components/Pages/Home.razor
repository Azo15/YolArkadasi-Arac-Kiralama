<!-- 2.8 STICKY SCROLL STORYTELLING STAGE (tinyPod & Unifiers of Japan İlhamlı) -->
<section id="scroll-story-stage" class="story-scroll-container" data-active-chapter="0" aria-label="Yolculuk hikayesi ve scroll vitrini">
    <div class="story-section-intro reveal-on-scroll">
        <span class="story-kicker">İNTERAKTİF DENEYİM</span>
        <h2>Kaydırdıkça şekillenen <span>akıllı kiralama.</span></h2>
        <p>Her adımda şeffaf fiyat, sıfır çakışma ve premium filo deneyimi.</p>
    </div>

    <div class="story-split-layout">
        <!-- Sol Kolon: Kaydırmalı Hikaye Bölümleri -->
        <div class="story-chapters-col">
            <article class="story-chapter active" data-chapter="0">
                <div class="chapter-badge">01 // FİLO MÜHENDİSLİĞİ</div>
                <h3>15 seçkin model, dört ayrı sürüş karakteri.</h3>
                <p>Ekonomik şehir içi araçlardan elektrikli SUV'lara ve Porsche 911 Carrera gibi ikonlara kadar her rota için bakımlı, tam donanımlı filo.</p>
                <div class="chapter-metrics">
                    <span><b>15+</b> Güncel Araç</span>
                    <span><b>4</b> Segment</span>
                </div>
            </article>

            <article class="story-chapter" data-chapter="1">
                <div class="chapter-badge">02 // AKILLI ÇAKIŞMA MOTORU</div>
                <h3>Dolu tarihlerde kaybolma, tek tıkla müsait günü yakala.</h3>
                <p>Seçtiğin tarih başka bir rezervasyonla çakıştığında sistem seni bekletmez; alternatif müsait tarih aralığını anında önerip tek dokunuşla günceller.</p>
                <div class="chapter-metrics">
                    <span><b>0 ms</b> Çakışma Tespiti</span>
                    <span><b>1 Tık</b> Tarih Önerisi</span>
                </div>
            </article>

            <article class="story-chapter" data-chapter="2">
                <div class="chapter-badge">03 // DİNAMİK FİYATLANDIRMA</div>
                <h3>Sürpriz fatura yok, her kuruş anlık hesaplanır.</h3>
                <p>Tam kapsamlı kasko, çocuk koltuğu ve ek sürücü tercihlerini eklediğin anda gün sayısıyla çarpılır; özet panelin gerçek zamanlı güncellenir.</p>
                <div class="chapter-metrics">
                    <span><b>250 ₺</b> Tam Kasko / Gün</span>
                    <span><b>%100</b> Şeffaf Özet</span>
                </div>
            </article>

            <article class="story-chapter" data-chapter="3">
                <div class="chapter-badge">04 // İZOLE A4 DİJİTAL FİŞ</div>
                <h3>Rezervasyonunu onayla, resmi teslim fişini tek tıkla yazdır.</h3>
                <p>Tüm kayıtların tarayıcı belleğinde güvenle saklanır. Dilediğin rezervasyon için tek sayfalık resmi A4 teslim fişini izole yazdırma motoruyla alabilirsin.</p>
                <div class="chapter-metrics">
                    <span><b>A4</b> İzole Baskı</span>
                    <span><b>7/24</b> Kalıcı Kayıt</span>
                </div>
            </article>
        </div>

        <!-- Sağ Kolon: Pinned Sticky 3D Scrubbing Sahnesi -->
        <div class="story-sticky-col">
            <div class="sticky-viewport-frame">
                <div class="stage-ambient-glow" data-parallax-speed="-0.10"></div>

                <!-- Üst İlerleme Noktaları -->
                <div class="stage-top-hud">
                    <span class="stage-hud-label">YOLARKADAŞI // CANLI SAHNE</span>
                    <div class="stage-progress-dots" aria-hidden="true">
                        <span class="stage-progress-dot active"></span>
                        <span class="stage-progress-dot"></span>
                        <span class="stage-progress-dot"></span>
                        <span class="stage-progress-dot"></span>
                    </div>
                </div>

                <!-- 3D Scroll-Scrubbed Araç Sahnesi -->
                <div class="stage-3d-card">
                    <div class="stage-slide active">
                        <img src="images/cars/porsche911.jpg" alt="Porsche 911 Carrera" />
                        <div class="stage-slide-caption">
                            <span>01 • PREMIUM İKON</span>
                            <strong>Porsche 911 Carrera</strong>
                        </div>
                    </div>
                    <div class="stage-slide">
                        <img src="images/cars/teslamodely.jpg" alt="Tesla Model Y" />
                        <div class="stage-slide-caption">
                            <span>02 • ELEKTRİKLİ AKILLI SUV</span>
                            <strong>Tesla Model Y</strong>
                        </div>
                    </div>
                    <div class="stage-slide">
                        <img src="images/cars/mercedes.jpg" alt="Mercedes-Benz C 200" />
                        <div class="stage-slide-caption">
                            <span>03 • İŞ & KONFOR SINIFI</span>
                            <strong>Mercedes-Benz C 200</strong>
                        </div>
                    </div>
                    <div class="stage-slide">
                        <img src="images/cars/bmw320i.jpg" alt="BMW 320i" />
                        <div class="stage-slide-caption">
                            <span>04 • DİNAMİK SÜRÜŞ</span>
                            <strong>BMW 320i</strong>
                        </div>
                    </div>
                </div>

                <!-- Yüzen Parallax Telemetri Etiketleri -->
                <div class="floating-telemetry chip-top" data-parallax-speed="-0.08">
                    <span class="telemetry-dot"></span>
                    <div>
                        <small>DURUM</small>
                        <strong>Anında Teslime Hazır</strong>
                    </div>
                </div>

                <div class="floating-telemetry chip-bottom" data-parallax-speed="0.09">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    <div>
                        <small>GÜVENCE</small>
                        <strong>Muafiyetsiz Tam Kasko</strong>
                    </div>
                </div>

                <div class="stage-scroll-meter">
                    <div class="stage-scroll-fill"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3. FİLO KATALOĞU -->
<div id="fleet">
    @if (_loading)
    {
        <div class="loading-state">
            <span class="loader"></span>
            <p>Araç filosu yükleniyor...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="empty-state">
            <strong>Araç listesi şu an yüklenemedi.</strong>
            <p>@_error</p>
        </div>
    }
    else
    {
        <CarList Cars="_cars" />
    }
</div>

@code {
    private List<Car> _cars = [];
    private bool _loading = true;
    private string? _error;
    private int _activeShowcase;
    private System.Threading.Timer? _sliderTimer;

    private List<Car> _showcaseCars
    {
        get
        {
            if (_cars.Count == 0) return [];
            var curated = _cars.Where(c => c.Id is "C013" or "C008" or "C007" or "C011" or "C014")
                               .OrderByDescending(c => c.DailyPrice)
                               .ToList();
            return curated.Count > 0 ? curated : _cars.Take(5).ToList();
        }
    }

    private Car? CurrentFeaturedCar => _showcaseCars.Count == 0 ? null : _showcaseCars[_activeShowcase % _showcaseCars.Count];

    private void PrevFeaturedSlide()
    {
        if (_showcaseCars.Count > 0)
        {
            _activeShowcase = (_activeShowcase - 1 + _showcaseCars.Count) % _showcaseCars.Count;
            RestartSliderTimer();
        }
    }

    private void NextFeaturedSlide()
    {
        if (_showcaseCars.Count > 0)
        {
            _activeShowcase = (_activeShowcase + 1) % _showcaseCars.Count;
        }
    }

    private void SelectFeaturedSlide(int index)
    {
        if (_showcaseCars.Count > 0 && index >= 0 && index < _showcaseCars.Count)
        {
            _activeShowcase = index;
            RestartSliderTimer();
        }
    }

    private void RestartSliderTimer()
    {
        _sliderTimer?.Change(TimeSpan.FromSeconds(6), TimeSpan.FromSeconds(5));
    }

    private void StartSliderTimer()
    {
        _sliderTimer?.Dispose();
        _sliderTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() =>
            {
                NextFeaturedSlide();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnInitializedAsync()
    {
        try 
        { 
            _cars = (await Cars.GetCarsAsync()).ToList(); 
            StartSliderTimer();
        }
        catch (Exception ex) 
        { 
            _error = ex.Message; 
        }
        finally 
        { 
            _loading = false; 
        }
    }

    public void Dispose()
    {
        _sliderTimer?.Dispose();
    }
}
