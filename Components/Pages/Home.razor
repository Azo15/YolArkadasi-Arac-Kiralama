@page "/"
@page "/cars"
@inject CarService Cars

<PageTitle>Araç Kirala | yolarkadaşı</PageTitle>

<section class="welcome-row">
    <div><span class="eyebrow">ÖZGÜRCE YOLA ÇIK</span><h1>Yolculuğun burada <span>başlıyor.</span></h1><p>İhtiyacına uygun aracı bul, tarihlerini seç ve gerisini bize bırak.</p></div>
    <div class="welcome-badge"><span>✦</span> Güvenli ve kolay kiralama</div>
</section>

@if (_loading)
{
    <div class="loading-state"><span class="loader"></span><p>Araçlar yükleniyor...</p></div>
}
else if (_error is not null)
{
    <div class="empty-state"><strong>Araç listesi şu an yüklenemedi.</strong><p>@_error</p></div>
}
else
{
    <CarList Cars="_cars" />
}

@code {
    private List<Car> _cars = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _cars = (await Cars.GetCarsAsync()).ToList(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
